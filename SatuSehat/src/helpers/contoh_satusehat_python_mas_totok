                    coalesce(max(unit_visit.serviced_end), date_format(coalesce(min(visite.visite_dt), min(unit_visit.serviced_start)), '%Y-%m-%d %H:%i:%s'))+interval 1 minute as finish_end_date,

                    group_concat(distinct diagnosa.diagnosa_dt separator ' || ')+interval 1 minute as diagnosa_date,
                    group_concat(distinct erm_rswj.icd_mapping.icd_10_code separator ' || ') as icd10_code,
                    group_concat(distinct erm_rswj.icd_mapping.icd_10_desc separator ' || ') as icd10_desc,
                    '-' as condition_rank,
                    NULL as encounter_uuid,
                    group_concat(distinct billing.billing_dt separator ' || ')+interval 1 minute as treathment_dt,
                    group_concat(distinct erm_rswj.master_icd_9cm.icd_9cm_code separator ' || ') as icd9cm_code,
                    group_concat(distinct erm_rswj.master_icd_9cm.icd_9cm_desc separator ' || ') as icd9cm_desc,
                    registry.pulse,
                    registry.respiration,
                    registry.systole,
                    registry.diastole,
                    registry.temperature
                from patient
                join registry on registry.mr_id = patient.mr_id
                join billing on billing.registry_id=registry.registry_id
                left join erm_rswj.master_icd_9cm on erm_rswj.master_icd_9cm.icd_9cm_avesina=billing.medical_service_id
                join unit_visit on unit_visit.registry_id = registry.registry_id
                join service_unit on service_unit.srvc_unit_id = unit_visit.unit_id_to and unit_group_id in ('8', '9')
                left join visite on visite.unit_visit_id = unit_visit.unit_visit_id
                left join diagnosa on diagnosa.visite_id = visite.visite_id
                left join diagnosa_dtl on diagnosa_dtl.diagnosa_id = diagnosa.diagnosa_id
                left join erm_rswj.icd_mapping on erm_rswj.icd_mapping.icd_id=diagnosa_dtl.icd_id
                left join employee on employee.employee_id=visite.employee_id
                where
                    registry.registry_dt
                    between date_format('{start_date} 00:00:00', '%Y-%m-%d 00:00:00')
                    and date_format('{end_date} 23:59:59', '%Y-%m-%d 23:59:59')
                    and registry.in_out_sts = 'O'
                group by
                    registry.registry_id
                order by
                    registry.registry_dt asc;
                """
        erm_cursor.execute(query)
        patient_registry = erm_cursor.fetchall()
        erm_cursor.close()
        erm_connection.close()
        
        erm_connection = mysql.connector.connect(**db_erm)

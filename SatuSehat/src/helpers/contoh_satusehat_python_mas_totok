def get_token():
    try:
        global token
        url = f"{env.get('auth_url')}/accesstoken?grant_type=client_credentials"
        payload = f"client_id={env.get('client_id')}&client_secret={env.get('client_secret')}"
        headers = {'Content-Type': 'application/x-www-form-urlencoded'}
        response = requests.post(url, headers=headers, data=payload)
        time_elapsed = f"{str(response.elapsed.total_seconds())} seconds"
        if response.status_code == 200:
            json_response = response.json()
            access_token = json_response.get('access_token')
            expires_in = json_response.get('expires_in')
            status = json_response.get('status')
            token = access_token
            print(f"Access Token: {token} - {status}")
            print("-" * 50)
        else:
            print("Failed to get token:", response.text)
    except ValueError as e:
        print(f"Error on GetToken() :\n{e}")
get_token()

def date_object_to_utc(date_object):
    try:
        try:
            date_str = date_object.replace(tzinfo=ZoneInfo("Asia/Jakarta")).strftime('%Y-%m-%dT%H:%M:%S%z')
            date_str = datetime.strptime(date_str, '%Y-%m-%dT%H:%M:%S%z')
        except:
            dt_str_to_object = datetime.strptime(date_object, '%Y-%m-%d %H:%M:%S')
            date_str = dt_str_to_object.replace(tzinfo=ZoneInfo("Asia/Jakarta")).strftime('%Y-%m-%dT%H:%M:%S%z')
            date_str = datetime.strptime(date_str, '%Y-%m-%dT%H:%M:%S%z')
        date_utc = date_str.astimezone(ZoneInfo("UTC"))
        datetime_string = date_utc.strftime("%Y-%m-%dT%H:%M:%S%z")
        string_date_utc = datetime_string[:-2] + ":" + datetime_string[-2:]
        return string_date_utc
    except ValueError as e:
        print(f"Error on ConvertDateUTC() :\n{e}")

def load_registry(start_date, end_date):

def validate_registry(start_date, end_date):
    try:
        print("Validate Registry Start. Please wait...")
        print("-" * 50)
        erm_connection = mysql.connector.connect(**db_erm)
        erm_cursor = erm_connection.cursor()
        query = f"""
            SELECT location_uuid, practitioner_nik, patient_nik 
            FROM erm_rswj.satusehat
            WHERE organization_uuid IS NOT NULL

            AND location_uuid IS NOT NULL AND location_uuid!=''
            AND location_srvc_unit_id IS NOT NULL AND location_srvc_unit_id!=''
            AND location_name IS NOT NULL AND location_name!=''

            AND practitioner_nik IS NOT NULL AND practitioner_nik!=''
            AND practitioner_ihs_number IS NOT NULL AND practitioner_ihs_number!=''
            AND practitioner_name IS NOT NULL AND practitioner_name!=''

            AND patient_nik IS NOT NULL AND patient_nik !=''
            AND patient_ihs_number IS NOT NULL AND patient_ihs_number !=''
            AND patient_name IS NOT NULL AND patient_name !=''

            AND (location_validation IS NULL OR practitioner_validation IS NULL OR patient_validation IS NULL)
            AND (registry_date between date_format('{start_date} 00:00:00', '%Y-%m-%d 00:00:00')
            AND date_format('{end_date} 23:59:59', '%Y-%m-%d 23:59:59'))
            """
        erm_cursor.execute(query)
        patient_registrys = erm_cursor.fetchall()
        erm_cursor.close()
        erm_connection.close()

        arr_location = []
        arr_practitioner = []
        arr_patient = []
        for registry in patient_registrys:
            location_uuid = registry[0]
            practitioner_nik = registry[1]
            patient_nik = registry[2]
            if (location_uuid not in arr_location) or (practitioner_nik not in arr_practitioner) or (patient_nik not in arr_patient):
                if location_validation(location_uuid):
                    erm_connection = mysql.connector.connect(**db_erm)
                    erm_cursor = erm_connection.cursor()
                    update_query = "UPDATE erm_rswj.satusehat SET location_validation=%s WHERE location_uuid=%s;"
                    update_val = ('1', location_uuid)
                    erm_cursor.execute(update_query, update_val)
                    erm_connection.commit()
                    erm_cursor.close()
                    erm_connection.close()
                    arr_location.append(location_uuid)
                    
                if practitioner_nik is not None:
                    if " || " in practitioner_nik:
                        practitioner_nik_split = practitioner_nik.split(' || ')
                        for practitioner_item in practitioner_nik_split:
                            if practitioner_validation(practitioner_item):
                                erm_connection = mysql.connector.connect(**db_erm)
                                erm_cursor = erm_connection.cursor()
                                update_query = "UPDATE erm_rswj.satusehat SET practitioner_validation=%s WHERE practitioner_nik=%s;"
                                update_val = ('1', practitioner_item)
                                erm_cursor.execute(update_query, update_val)
                                erm_connection.commit()
                                erm_cursor.close()
                                erm_connection.close()
                                arr_practitioner.append(practitioner_item)
                    else:   
                        if practitioner_validation(practitioner_nik):
                            erm_connection = mysql.connector.connect(**db_erm)
                            erm_cursor = erm_connection.cursor()
                            update_query = "UPDATE erm_rswj.satusehat SET practitioner_validation=%s WHERE practitioner_nik=%s;"
                            update_val = ('1', practitioner_nik)
                            erm_cursor.execute(update_query, update_val)
                            erm_connection.commit()
                            erm_cursor.close()
                            erm_connection.close()
                            arr_practitioner.append(practitioner_nik)

                check_patient_validation = patient_validation(patient_nik)
                if check_patient_validation[0] == True:
                    patient_ihs_number = check_patient_validation[1]
                    erm_connection = mysql.connector.connect(**db_erm)
                    erm_cursor = erm_connection.cursor()
                    update_query = "UPDATE erm_rswj.satusehat SET patient_validation=%s, patient_ihs_number=%s WHERE patient_nik=%s;"
                    update_val = ('1', patient_ihs_number, patient_nik)
                    erm_cursor.execute(update_query, update_val)
                    erm_connection.commit()
                    erm_cursor.close()
                    erm_connection.close()
                    arr_patient.append(patient_nik)
            time.sleep(2)
        print("Validate Registry Finish.")
        print("-" * 50)
    except ValueError as e:
        print(f"Error on ValidateRegistry() :\n{e}")


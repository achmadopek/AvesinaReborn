def run_satusehat_update(start_date, end_date):
    try:
        load_registry(start_date, end_date)
        validate_registry(start_date, end_date)
        erm_connection = mysql.connector.connect(**db_erm)
        erm_cursor = erm_connection.cursor()
        query = f"""
            SELECT registry_id, encounter_uuid, diagnosa_date,
            icd10_code, icd10_desc, treathment_dt, icd9cm_code, icd9cm_desc,
            pulse, respiration, systole, diastole, temperature
            FROM erm_rswj.satusehat
            WHERE organization_uuid IS NOT NULL

                AND location_uuid IS NOT NULL AND location_uuid!=''
                AND location_srvc_unit_id IS NOT NULL AND location_srvc_unit_id!=''
                AND location_name IS NOT NULL AND location_name!=''

                AND practitioner_nik IS NOT NULL AND practitioner_nik!=''
                AND practitioner_ihs_number IS NOT NULL AND practitioner_ihs_number!=''
                AND practitioner_name IS NOT NULL AND practitioner_name!=''

                AND patient_nik IS NOT NULL AND patient_nik !=''
                AND patient_ihs_number IS NOT NULL AND patient_ihs_number !=''
                AND patient_name IS NOT NULL AND patient_name !=''

                AND location_validation = 1
                AND practitioner_validation = 1
                AND patient_validation = 1
                AND (registry_date between date_format('{start_date} 00:00:00', '%Y-%m-%d 00:00:00')
                AND date_format('{end_date} 23:59:59', '%Y-%m-%d 23:59:59'))
                -- AND registry_id='220107080614700898RSJK' #for debug only
            """
        erm_cursor.execute(query)
        patient_registrys = erm_cursor.fetchall()
        erm_cursor.close()
        erm_connection.close()
        print("RUNNING : POST data SatuSehat. Please wait...")
        print("-" * 50)
        kunjungan_awal   = 0
        kunjungan_update = 0
        condition_count  = 0
        treathment_count = 0
        kunjungan_finish = 0
        resume_diet_count = 0
        
        pulse_count = 0
        respiration_count = 0
        systole_count = 0
        diastole_count = 0
        temperature_count = 0

        get_token()
        for patient_registry in patient_registrys:
            registry_id = patient_registry[0]
            encounter_uuid = patient_registry[1]

            diagnosa_date = patient_registry[2]
            icd10_code = patient_registry[3]
            icd10_desc = patient_registry[4]

            treathment_dt = patient_registry[5]
            icd9cm_code = patient_registry[6]
            icd9cm_desc = patient_registry[7]

            pulse = patient_registry[8]
            respiration = patient_registry[9]
            systole = patient_registry[10]
            diastole = patient_registry[11]
            temperature = patient_registry[12]

            time.sleep(2)

            if encounter_uuid is None:
                encounter_kunjungan_awal(registry_id)
                kunjungan_awal += 1
            encounter_update_inprogress(registry_id)
            kunjungan_update += 1
            
            if diagnosa_date is not None and icd10_code is not None and icd10_desc is not None:
                condition(registry_id)
                condition_count += 1

            if treathment_dt is not None and icd9cm_code is not None and icd9cm_desc is not None:
                treathment(registry_id)
                treathment_count += 1

            if pulse is not None and pulse != '':
                obs_pulse(registry_id)
                pulse_count += 1
            
            if respiration is not None and respiration != '':
                obs_respiration(registry_id)
                respiration_count += 1
            
            if systole is not None and systole != '':
                obs_systole(registry_id)
                systole_count += 1
            
            if diastole is not None and diastole != '':
                obs_diastole(registry_id)
                diastole_count += 1
            
            if temperature is not None and temperature != '':
                obs_temperature(registry_id)
                temperature_count += 1

            resume_diet(registry_id)
            resume_diet_count += 1
            encounter_update_finish(registry_id)
            kunjungan_finish += 1

        print("-" * 50)
        print(f"DONE : POST {str(kunjungan_awal)} Encounter Kunjungan Awal")
        print(f"DONE : PUT  {str(kunjungan_update)} Encounter Update Inprogress")
        print(f"DONE : POST  {str(condition_count)} Condition ICD-10")
        print(f"DONE : POST  {str(treathment_count)} Treathment_dt ICD-9cm")
        print(f"DONE : POST  {str(pulse_count)} Observation Pulse")
        print(f"DONE : POST  {str(respiration_count)} Observation Respiration")
        print(f"DONE : POST  {str(systole_count)} Observation Systole")
        print(f"DONE : POST  {str(diastole_count)} Observation Diastole")
        print(f"DONE : POST  {str(temperature_count)} Observation Temperature")
        print(f"DONE : POST  {str(resume_diet_count)} Resume Diet")
        print(f"DONE : PUT  {str(kunjungan_finish)} Encounter Update Finish")
        print("-" * 50)
    except ValueError as e:
        print(f"Error on SatuSehatUpdate() :\n{e}")
        

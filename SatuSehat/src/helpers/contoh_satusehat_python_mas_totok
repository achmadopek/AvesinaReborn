                    registry.registry_dt as registry_date,
                    coalesce(max(unit_visit.serviced_end), date_format(coalesce(min(visite.visite_dt), min(unit_visit.serviced_start)), '%Y-%m-%d %H:%i:%s'))+interval 1 minute as out_date,

                    registry.registry_dt as arrived_start_date,
                    coalesce(min(visite.visite_dt), min(unit_visit.serviced_start))+interval 1 minute as arrived_end_date,
                    coalesce(min(visite.visite_dt), min(unit_visit.serviced_start))+interval 1 minute as inprogress_start_date,
